# Copie para .env.local (que NÃO vai para o Git) e preencha. Passo a passo: docs/GOOGLE-AUTH.md
# Login com Google (Auth.js v5). Sem as três, o botão "Entrar com Google" não aparece.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Gere com: npx auth secret   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
# Só em produção (em localhost o Auth.js descobre sozinho):
# AUTH_URL=https://seu-dominio.com
